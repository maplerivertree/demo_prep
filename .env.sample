# Copy this file to ".env" and fill in your own values.
# Never commit the real ".env" file — it holds details for your Foundry project.

# The endpoint URL of your Microsoft Foundry project.
# Example: https://my-foundry-resource.services.ai.azure.com/api/projects/my-project
FOUNDRY_PROJECT_ENDPOINT=

# The name of the model deployment (inside that Foundry project) to chat with.
# Example: gpt-4o
FOUNDRY_MODEL_DEPLOYMENT_NAME=
